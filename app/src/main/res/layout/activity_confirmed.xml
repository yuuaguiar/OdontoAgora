<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="36dp">

        <!-- Topo: Badge Dentista Encontrado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DENTISTA ENCONTRADO"
            android:textColor="@color/brand"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:background="@drawable/badge_blue"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dentista encontrado!"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu horário está reservado por 45 minutos."
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Card Dentista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DENTISTA RESPONSÁVEL"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_dentista_nome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drª Marina Lopes"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tv_dentista_cro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRO 12874 • Clínica geral • ★ 4,9"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                android:text="VERIFICADA"
                    android:textColor="@color/success"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/badge_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card Clínica -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLÍNICA"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_clinica_nome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clínica Sorriso Centro"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_clinica_endereco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rua das Flores, 248 • 3,2 km"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Card Timer Regressivo 45 min -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHEGUE À CLÍNICA EM"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_countdown_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="44:32"
                android:textColor="@color/warning"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginVertical="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não perca sua reserva • A contagem segue ativa"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card Código de Chegada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÓDIGO DE CHEGADA"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mostre na recepção ao chegar"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_arrival_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4821"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Badge Pagamento Protegido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pagamento protegido pelo app ••• 4820"
            android:textColor="@color/success"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="@drawable/badge_green"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Botão Confirmar e ir à clínica -->
        <Button
            android:id="@+id/btn_confirmar_chegada"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirmar e ir à clínica"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_background"
            android:layout_marginBottom="12dp" />

        <!-- Botão Cancelar Chamado -->
        <Button
            android:id="@+id/btn_cancelar_confirmado"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancelar chamado"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:background="@drawable/card_background" />

    </LinearLayout>
</ScrollView>
